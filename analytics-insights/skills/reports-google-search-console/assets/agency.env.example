# ~/clients/agency.env — SHARED agency credentials
#
# One file for the whole agency. Every skill named reports-* reads it. Never
# copy these values into a client project, never pass them on a command line,
# never paste them into a report, a ticket, or a chat.
#
#   cp agency.env.example ~/clients/agency.env
#   chmod 600 ~/clients/agency.env
#
# Then confirm it is outside every git repository:
#   git check-ignore -v ~/clients/agency.env   # or keep ~/clients/ out of git entirely
#
# PLACEHOLDERS ONLY BELOW. Replace each with a real value; commit none of them.

# --- OAuth client, from Google Cloud Console -> APIs & Services -> Credentials.
# Application type: Desktop app.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Refresh token for a Google account with access to the client properties.
#
# THE SCOPE MATTERS. Search Console needs:
#     https://www.googleapis.com/auth/webmasters.readonly
# A token minted for Google Ads alone carries only the adwords scope: the token
# exchange succeeds and the first Search Console call fails. Re-mint this one
# with BOTH scopes, or add GSC_REFRESH_TOKEN below.
#
# If the OAuth consent screen is an External app left in "Testing", this token
# expires after 7 days. Publish the app to Production, or make it Internal.
GOOGLE_REFRESH_TOKEN=1//0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OPTIONAL: a Search Console-only refresh token, used in preference to the
# shared one above. Useful when the shared token cannot easily be re-minted.
# GSC_REFRESH_TOKEN=1//0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OPTIONAL: service-account authentication instead of a user account.
# Point at the JSON key downloaded from Google Cloud, stored OUTSIDE every repo.
# The service account's client_email must then be added to each client's Search
# Console property (Settings -> Users and permissions -> Add user -> Full or
# Restricted). Cloud IAM roles do not grant Search Console access.
# GOOGLE_SERVICE_ACCOUNT_FILE=/Users/you/clients/.keys/gsc-reporting.json

# --- OPTIONAL: Workspace domain-wide delegation — the user to impersonate.
# Requires an admin to authorise the service account's client ID for the
# webmasters.readonly scope.
# GOOGLE_IMPERSONATE_SUBJECT=reporting@youragency.com

# --- Required Google API, enabled on the Cloud project behind these credentials:
#       Google Search Console API
# Google Cloud is where API ACCESS is configured. The data itself comes from the
# Search Console API, and property PERMISSION is granted inside Search Console.
# They fail differently and are fixed in different places.

# --- Other reports-* skills add their own keys to this same file (the Google Ads
# developer token, for instance). Keep all of them here, and none of them in a
# client project.
