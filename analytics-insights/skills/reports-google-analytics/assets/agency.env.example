# ~/clients/agency.env
#
# The shared agency credential file. EVERY skill whose name begins with
# reports- reads its Google credentials from this one file.
#
#   * Never copy it into a client project.
#   * Never commit it.
#   * chmod 600 it.
#   * Every value below is a placeholder. Replace them; do not commit the result.
#
# Reporting on GA4 needs no developer token -- there is no such thing for the
# Google Analytics APIs. The Ads keys are here because the same OAuth client
# serves both skills.

# --- OAuth client, from the Google Cloud project -------------------------
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-<your-client-secret>

# --- Refresh token for the Google account the agency uses ----------------
# Mint it with BOTH scopes so one token serves Analytics and Ads:
#   https://www.googleapis.com/auth/analytics.readonly
#   https://www.googleapis.com/auth/adwords
# See references/authentication.md. An OAuth consent screen left in "Testing"
# issues refresh tokens that expire after seven days.
GOOGLE_REFRESH_TOKEN=<your-refresh-token>

# --- Google Ads only. Analytics ignores these. ---------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=xxxxxxxxxxxxxxxxxxxxxx
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# --- Optional: the service-account alternative ---------------------------
# Set this ONLY if the agency uses a service account instead of the OAuth
# credentials above. When the OAuth trio is complete it wins, so adding a key
# file cannot silently change how existing clients authenticate.
# Signing needs `cryptography` or `rsa` installed; the OAuth path needs neither.
# Each client property must be shared with the key's client_email.
#
# GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/outside/any/repo/service-account.json
