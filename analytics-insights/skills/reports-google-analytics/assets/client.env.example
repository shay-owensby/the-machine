# <client project>/.env
#
# Client configuration. NO SECRETS BELONG IN THIS FILE -- credentials live in
# ~/clients/agency.env and are shared across every client.

# --- Required ------------------------------------------------------------
# The GA4 property ID: digits only.
# Find it at Admin > Property > Property details, or in a GA4 URL as ?p=123456789
# or by running:  python3 scripts/check_config.py --list-properties
#
# NOT the measurement ID (G-XXXXXXXXXX) -- that is the tag on the website.
# NOT a Universal Analytics ID (UA-12345-1) -- those stopped collecting in 2023.
# NOT a Tag Manager container (GTM-XXXXXX).
#
# GA4 has no login customer ID. The property ID is the whole address.
GA4_PROPERTY_ID=123456789

# --- Optional ------------------------------------------------------------

# Shown in the report header. The property name is read from the Admin API when
# it is available; this is the fallback, not an override.
# GA4_PROPERTY_NAME=Acme Home Services
# GA4_CLIENT_NAME=Acme Ltd
# GA4_SITE_URL=https://www.acme.com
# GA4_ACCOUNT_ID=98765

# Reporting window. Default: the most recent 30 completed days ending
# yesterday, in the property's own time zone, against the 30 days before that.
# GA4_REPORT_DAYS=30

# Extra settling days before "yesterday". Set to 1 or 2 for a property where
# late-arriving data has made a report disagree with itself.
# GA4_LAG_DAYS=0

# WHICH key events represent real business outcomes for THIS client.
# GA4 records which events are key events; it does not record what they mean.
# Leave this unset and the report says the business meaning is undetermined --
# which is the honest default, not a failure.
# GA4_KEY_EVENTS=generate_lead,contact_form_submit

# Override the currency symbol used in tables. The currency itself comes from
# the property.
# GA4_CURRENCY_SYMBOL=$
