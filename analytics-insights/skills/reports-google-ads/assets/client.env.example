# <client project root>/.env — PER-CLIENT configuration
#
# Which account to report on, and how. NO CREDENTIALS EVER LIVE HERE: the OAuth
# client, refresh token and developer token are shared and belong in
# ~/clients/agency.env.
#
#   cp client.env.example ~/clients/<client>/.env
#
# PLACEHOLDERS ONLY. Replace the customer ID with the client's own.

# --- The Google Ads account being reported on (the OPERATING account, not a
# manager). Dashed or bare, both accepted; exactly ten digits.
#
# GOOGLE_ADS_LOGIN_CUSTOMER_ID is ALSO accepted for this, because that is the key
# these .env files have historically labelled the account with. An existing file
# carrying only that key works unchanged. Naming the account explicitly here is
# still worth doing: it frees the login key to mean what Google means by it.
GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# --- OPTIONAL: the manager (MCC) account to authenticate THROUGH, when this
# client's account is managed by one that is not the agency default.
#
# It is sent as the login-customer-id header only when it names a DIFFERENT
# account from the one above. If it is the only ads ID in this file, it is read
# as the account instead and no header is sent.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=098-765-4321

# --- OPTIONAL: pin the Google Ads API version. Unset, the client uses the
# newest it knows and walks backwards if that version has been sunset.
# GOOGLE_ADS_API_VERSION=v21

# --- OPTIONAL: period length in days for both the current and comparison
# windows. Default 30.
# GOOGLE_ADS_REPORT_DAYS=30

# --- OPTIONAL: hold the window back by this many days so conversion lag has
# settled. Worth setting for considered purchases and B2B, where conversions
# keep landing for a week or more after the click and the most recent period
# always looks worse than it turns out to be.
# GOOGLE_ADS_LAG_DAYS=3

# --- OPTIONAL: which conversion actions are the real business outcome, comma
# separated, exactly as named in the account. Used to distinguish the KPI that
# matters from supporting actions when an account counts several things.
# GOOGLE_ADS_PRIMARY_CONVERSION_ACTIONS=Purchase,Phone Call

# --- Other reports-* skills may add their own keys to this same file. Keep
# credentials out of all of them.
