# ~/clients/agency.env — SHARED agency credentials
#
# One file for the whole agency. Every skill named reports-* reads it. Never
# copy these values into a client project, never pass them on a command line,
# never paste them into a report, a ticket, or a chat.
#
#   cp agency.env.example ~/clients/agency.env
#   chmod 600 ~/clients/agency.env
#
# Then confirm it is outside every git repository:
#   git check-ignore -v ~/clients/agency.env   # or keep ~/clients/ out of git entirely
#
# PLACEHOLDERS ONLY BELOW. Replace each with a real value; commit none of them.

# --- OAuth client, from Google Cloud Console -> APIs & Services -> Credentials
# Application type: Desktop app. Scope: https://www.googleapis.com/auth/adwords
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Refresh token for a Google account with access to the client accounts.
# If the OAuth consent screen is an External app left in "Testing", this token
# expires after 7 days. Publish the app to Production, or make it Internal.
GOOGLE_REFRESH_TOKEN=1//0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Developer token, from the Google Ads MANAGER account -> Admin -> API Center.
# Needs "Basic access"; a token at "Test Account Access" returns
# DEVELOPER_TOKEN_NOT_APPROVED against every production account.
GOOGLE_ADS_DEVELOPER_TOKEN=xxxxxxxxxxxxxxxxxxxxxx

# --- Default manager (MCC) account for agency-managed clients.
# Sent as the login-customer-id header when a client's own account is named
# separately. A client with a different manager overrides this in their project
# .env. Not a secret; it lives here because most clients share it.
#
# NOTE: if a client project names no Google Ads account of its own, this value
# is used as the account to report on and the run warns loudly -- it is the
# agency-wide default, so it is very likely the wrong account for that client.
# Set GOOGLE_ADS_CUSTOMER_ID per client to avoid relying on that fallback.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=000-000-0000
